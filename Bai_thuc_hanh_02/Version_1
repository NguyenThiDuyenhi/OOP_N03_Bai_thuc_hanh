#include <iostream>
#include <string>
#include <iomanip>
#include <cstdlib>  
#include <ctime>    
#include <limits>
using namespace std;

class phuong_tien {
private:
    int ma_xe;
    string loai_xe;
    int gio_vao;
    int tg_do;

public:
    phuong_tien();
    phuong_tien(int ma, string loai, int gio, int tg);

    int lay_ma_xe() const;
    string lay_loai_xe() const;
    double tinh_phi() const;
    void hien_thi() const;
};

phuong_tien::phuong_tien() : ma_xe(0), loai_xe(""), gio_vao(0), tg_do(0) {}

phuong_tien::phuong_tien(int ma, string loai, int gio, int tg)
    : ma_xe(ma), loai_xe(loai), gio_vao(gio), tg_do(tg) {}

int phuong_tien::lay_ma_xe() const { return ma_xe; }
string phuong_tien::lay_loai_xe() const { return loai_xe; }

double phuong_tien::tinh_phi() const {
    double gia = (loai_xe == "Car") ? 6.0 : (loai_xe == "Motorcycle") ? 4.0 : 2.0;
    bool cao_diem = (gio_vao >= 6 && gio_vao <= 9) || (gio_vao >= 15 && gio_vao <= 18);
    double tong = 0;
    for (int h = 0; h < tg_do; ++h) {
        if (h < 2) tong += gia * (cao_diem ? 1.30 : 0.95);
        else       tong += gia * 0.90;
    }
    return tong;
}

void phuong_tien::hien_thi() const {
    cout << "  ID: " << ma_xe << " | " << loai_xe
         << " | " << gio_vao << "h | " << tg_do << "h"
         << " | Phi: $" << fixed << setprecision(2) << tinh_phi() << "\n";
}

class bai_xe {
private:
    int ma_bai;
    char kich_thuoc;
    static const int Max_xe = 3;
    phuong_tien ds_xe[Max_xe];
    int so_xe;

public:
    bai_xe();
    bai_xe(int ma, char kt);

    int lay_ma() const;
    int lay_so_xe() const;
    int suc_chua() const;
    bool day() const;
    int tim_xe(int ma_xe) const;
    bool them(const phuong_tien& v);
    bool xoa(int ma_xe);
    bool chua(int ma_xe) const;
    void hien_thi() const;
    bool co_loai(string loai, int& dem, double& tong) const;
    phuong_tien lay_xe(int i) const;
    void hien_thi_theo_loai(const string& loai) const;
};

bai_xe::bai_xe() : ma_bai(0), kich_thuoc('S'), so_xe(0) {}

bai_xe::bai_xe(int ma, char kt) : ma_bai(ma), kich_thuoc(kt), so_xe(0) {}

int bai_xe::lay_ma() const { return ma_bai; }
int bai_xe::lay_so_xe() const { return so_xe; }
phuong_tien bai_xe :: lay_xe(int i) const {return ds_xe[i];}

int bai_xe:: suc_chua() const {
	return (kich_thuoc == 'S') ? 1 : (kich_thuoc == 'M') ? 2 : 3;
} 

bool bai_xe :: day() const {
	return so_xe >= suc_chua();
}

int bai_xe::tim_xe(int ma_xe) const {
    for (int i = 0; i < so_xe; i++)
        if (ds_xe[i].lay_ma_xe() == ma_xe) return i;
    return -1;
}

bool bai_xe::chua(int ma_xe) const {
    return tim_xe(ma_xe) != -1;
}

bool bai_xe::them(const phuong_tien& v) {
    if (day()) return false;
    ds_xe[so_xe] = v;
    so_xe++;
    return true;
}

bool bai_xe::xoa(int ma_xe) {
    int idx = tim_xe(ma_xe);
    if (idx == -1) return false;
    for (int i = idx; i < so_xe - 1; i++)
        ds_xe[i] = ds_xe[i + 1];      
    so_xe--;
    return true;
}

void bai_xe::hien_thi() const {
    cout << "Bai " << ma_bai << " [" << kich_thuoc << "] "
         << so_xe << "/" << suc_chua() << " xe\n";
    for (int i = 0; i < so_xe; i++)
        ds_xe[i].hien_thi();
}

bool bai_xe::co_loai(string loai, int& dem, double& tong) const {
    dem = 0; tong = 0;
    for (int i = 0; i < so_xe; i++) {
        if (ds_xe[i].lay_loai_xe() == loai) {
            dem++;
            tong += ds_xe[i].tinh_phi();
        }
    }
    return dem > 0;
}
void bai_xe::hien_thi_theo_loai(const string& loai) const {
    cout << "Bai " << ma_bai << " [" << kich_thuoc << "]:\n";
    for (int i = 0; i < so_xe; i++)
        if (ds_xe[i].lay_loai_xe() == loai)
            ds_xe[i].hien_thi();
}

class SystemInterface {
private:
    static const int MAX_BAI = 10;
    bai_xe ds_bai[MAX_BAI];
    int so_bai;

    int tim_bai(int ma) const;               
    int nhap_so(const string& thong_bao);     
    int nhap_so_trong_khoang(const string& tb, int lo, int hi);

public:
    SystemInterface();
    void runMenu();
    bool ma_bai_ton_tai(int ma) const;
    bool ma_xe_ton_tai(int ma) const;
    int sinh_id_ngau_nhien();
};

SystemInterface::SystemInterface() : so_bai(0) {}

int SystemInterface::tim_bai(int ma) const {
    for (int i = 0; i < so_bai; i++)
        if (ds_bai[i].lay_ma() == ma) return i;
    return -1;
}

bool SystemInterface::ma_bai_ton_tai(int ma) const {
    return tim_bai(ma) != -1;
}

bool SystemInterface::ma_xe_ton_tai(int ma) const {
    for (int i = 0; i < so_bai; i++)
        if (ds_bai[i].chua(ma)) return true;
    return false;
}

int SystemInterface::sinh_id_ngau_nhien() {
    int id;
    do {
        id = rand() % 9000 + 1000;   
    } while (ma_bai_ton_tai(id) || ma_xe_ton_tai(id));
    return id;
}
int SystemInterface::nhap_so(const string& thong_bao) {
    int x;
    while (true) {
        cout << thong_bao;
        if (cin >> x) {
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            return x;
        }
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
        cout << "Nhap sai! Vui long nhap so.\n";
    }
}
void SystemInterface::runMenu() {
    int chon;
    while (true) {
        cout << "\n===== QUAN LY BAI DO XE =====\n";
        cout << "1. Tao bai do\n";
        cout << "2. Them xe\n";
        cout << "3. Xoa bai do\n";
        cout << "4. Lay xe ra\n";
        cout << "5. Hien thi tat ca bai do\n";
        cout << "6. Hien thi xe theo bai\n";
        cout << "7. Liet ke xe theo loai\n";
        cout << "8. Bao cao phi trung binh\n";
        cout << "9. Thoat\n";
        chon = nhap_so("Chon: ");            

        switch (chon) {
        case 1: {
            if (so_bai >= MAX_BAI) { cout << "Da dat toi da 10 bai!\n"; break; }
            int ma = nhap_so("Ma bai: ");
            char kt;
            do {
                cout << "Kich thuoc (S/M/L): "; cin >> kt;
                cin.ignore(numeric_limits<streamsize>::max(), '\n');
                kt = toupper(kt);
            } while (kt != 'S' && kt != 'M' && kt != 'L');

            if (ma_bai_ton_tai(ma)) {
                ma = sinh_id_ngau_nhien();
                cout << "Ma bai bi trung! Da gan ma ngau nhien: " << ma << "\n";
            }
            ds_bai[so_bai] = bai_xe(ma, kt);
            so_bai++;
            cout << "Da tao bai " << ma << "\n";
            break;
        }
        case 2: {
            int ma = nhap_so("Ma xe: ");
            string loai;
            cout << "Loai (Car/Motorcycle/Bicycle): "; cin >> loai;
            int gio = nhap_so("Gio vao (0-23): ");
            int tg  = nhap_so("Thoi luong (1-23): ");

            if (ma_xe_ton_tai(ma)) {
                ma = sinh_id_ngau_nhien();
                cout << "Ma xe bi trung! Da gan ma ngau nhien: " << ma << "\n";
            }
            phuong_tien v(ma, loai, gio, tg);
            bool ok = false;
            for (int i = 0; i < so_bai && !ok; i++)
                ok = ds_bai[i].them(v);
            if (ok) cout << "Da them xe " << ma << " | Phi: $"
                         << fixed << setprecision(2) << v.tinh_phi() << "\n";
            else cout << "Tat ca cac bai da day!\n";
            break;
        }
        case 3: {
            int ma = nhap_so("Ma bai can xoa: ");
            int idx = tim_bai(ma);
            if (idx == -1) { cout << "Khong tim thay bai!\n"; break; }
            for (int i = idx; i < so_bai - 1; i++)
                ds_bai[i] = ds_bai[i + 1];
            so_bai--;
            cout << "Da xoa bai " << ma << "\n";
            break;
        }
        case 4: {
            int ma = nhap_so("Ma xe can lay ra: ");
            bool ok = false;
            for (int i = 0; i < so_bai && !ok; i++)
                ok = ds_bai[i].xoa(ma);
            cout << (ok ? "Da lay xe ra\n" : "Khong tim thay xe\n");
            break;
        }
        case 5:
            if (so_bai == 0) cout << "Chua co bai nao.\n";
            for (int i = 0; i < so_bai; i++) ds_bai[i].hien_thi();
            break;
        case 6: {
            int ma = nhap_so("Ma bai: ");
            int idx = tim_bai(ma);
            if (idx == -1) cout << "Khong tim thay bai!\n";
            else ds_bai[idx].hien_thi();
            break;
        }
        case 7: {
		    string loai;
		    cout << "Loai xe: "; cin >> loai;
		    int dem; double tong;
		    bool co = false;
		    for (int i = 0; i < so_bai; i++)
		        if (ds_bai[i].co_loai(loai, dem, tong)) {
		            ds_bai[i].hien_thi_theo_loai(loai);   // ch? s?a dòng này
		            co = true;
		        }
		    if (!co) cout << "Khong co xe loai " << loai << "\n";
		    break;
		}
        case 8: {
            string loai_arr[3] = {"Car", "Motorcycle", "Bicycle"};
            cout << "--- Toan he thong ---\n";
            for (int t = 0; t < 3; t++) {
                int dem = 0; double tong = 0;
                for (int i = 0; i < so_bai; i++) {
                    int d; double s;
                    ds_bai[i].co_loai(loai_arr[t], d, s);
                    dem += d; tong += s;
                }
                cout << loai_arr[t] << ": ";
                if (dem == 0) cout << "khong co xe\n";
                else cout << dem << " xe | TB: $" << fixed << setprecision(2) << tong / dem << "\n";
            }
            cout << "--- Theo tung bai ---\n";
            for (int i = 0; i < so_bai; i++) {
                cout << "Bai " << ds_bai[i].lay_ma() << ":\n";
                for (int t = 0; t < 3; t++) {
                    int d; double s;
                    ds_bai[i].co_loai(loai_arr[t], d, s);
                    cout << "  " << loai_arr[t] << ": ";
                    if (d == 0) cout << "khong co xe\n";
                    else cout << d << " xe | TB: $" << fixed << setprecision(2) << s / d << "\n";
                }
            }
            break;
        }
        case 9:
            cout << "Tam biet!\n";
            return;
        default:
            cout << "Lua chon khong hop le!\n";
        }
    }
}
int main() {
	srand((unsigned)time(0));
    SystemInterface sys;
    sys.runMenu();
    return 0;
}
